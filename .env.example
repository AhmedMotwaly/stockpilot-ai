# Copy this file to .env and fill in values. Never commit .env.

# AI provider: mock (free, default) or claude (paid API, approve spending first)
STOCKPILOT_AI_PROVIDER=mock

# Only needed when STOCKPILOT_AI_PROVIDER=claude
ANTHROPIC_API_KEY=
# Choose a current model name from the Claude API documentation when you approve live use
STOCKPILOT_CLAUDE_MODEL=

# Agent limits
STOCKPILOT_MAX_TOOL_CALLS=6
STOCKPILOT_LLM_TIMEOUT_SECONDS=30

# Cost control for live API use, in EUR
STOCKPILOT_API_BUDGET_EUR=0

# Paths
STOCKPILOT_DB_PATH=database/stockpilot.db
